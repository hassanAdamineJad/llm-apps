# Choose exactly one provider: openai or ollama.
LLM_PROVIDER=openai

# Required only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Required only when LLM_PROVIDER=ollama. Local/private addresses are allowed here
# because this is an operator-controlled provider endpoint, not user website input.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

